{
  "name": "@sysdyn/web",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Reference web editor for @sysdyn/core — live parse, simulate, and chart.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-skill-zip.mjs && vite",
    "build": "node scripts/build-skill-zip.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
