{
  "name": "systemdiagram-monorepo",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "System Dynamics tooling — DSL, simulator, web app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r --filter ./packages/** test",
    "test:watch": "pnpm -r --filter ./packages/** test:watch",
    "typecheck": "pnpm -r --filter ./packages/** typecheck",
    "lint": "pnpm -r --filter ./packages/** lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
