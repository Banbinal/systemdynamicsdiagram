# Logistic-style population growth with a single carrying-capacity term.
# The simplest of the example models — useful for sanity checks.

title Simple Population Model

StartTime = 0
EndTime = 100
TimeStep = 0.25

stock Population = 100

constant BirthRate = 0.05
constant DeathRate = 0.02
constant CarryingCapacity = 500

calc PopulationPressure = Population / CarryingCapacity
calc ActualBirthRate = BirthRate * (1 - PopulationPressure * 0.7)

flow Births:
    Population * ActualBirthRate -+> Population

flow Deaths:
    Population * DeathRate --> Population

# Population should never go negative.
limit Population min = 0

# ── Reality Check assertions ──────────────────────────────────────────────
# These run an isolated simulation with their `when` overrides applied,
# then verify the assertion at every recorded step (`always`) or at a
# specific time (`at t = N`). Surfaced in the "Checks" tab.

# Stock invariant: with the limit above, Population can never go negative.
check Population_nonneg:
    then Population >= 0 always

# With death rate cranked up and births off, the population must collapse
# below half of its initial value within the simulation horizon.
check Crash_when_births_off:
    when BirthRate = 0
    when DeathRate = 0.1
    then Population <= 50 at t = 100

# Below carrying capacity at all times in the default scenario.
check Stays_below_capacity:
    then Population <= CarryingCapacity always

plot Population
plot ActualBirthRate

# ── Reference mode ────────────────────────────────────────────────────────
# Sterman's discipline: state the expected behaviour BEFORE simulating, so
# the model has a target to be calibrated against. Rendered as a dashed
# overlay on the simulation chart.
reference Population:
    (0, 100)
    (25, 250)
    (50, 400)
    (75, 470)
    (100, 490)
